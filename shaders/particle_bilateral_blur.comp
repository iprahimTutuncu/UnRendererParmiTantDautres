#version 450

layout(set = 0, binding = 0) uniform sampler2D gDepth;
layout(set = 1, binding = 0, r32f) uniform writeonly image2D gDepthModified;

layout(set = 2, binding = 0) uniform BlurParams {
    int filterRadius;           // e.g., 5
    float blurScale;            // affects spatial weight (Gaussian)
    float blurDepthFalloff;     // affects depth similarity weight
} params;

layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    float centerDepth = texelFetch(gDepth, coords, 0).r;

    float sum = 0.0;
    float wsum = 0.0;

    for (int dy = -params.filterRadius; dy <= params.filterRadius; ++dy) {
        for (int dx = -params.filterRadius; dx <= params.filterRadius; ++dx) {
            ivec2 offset = coords + ivec2(dx, dy);

            float sampled = texelFetch(gDepth, offset, 0).r;

            // Spatial Gaussian
            float r2 = float(dx * dx + dy * dy) * params.blurScale * params.blurScale;
            float spatialWeight = exp(-r2);

            // Depth/range Gaussian
            float depthDiff = sampled - centerDepth;
            float g = exp(-depthDiff * depthDiff * params.blurDepthFalloff * params.blurDepthFalloff);

            float weight = spatialWeight * g;

            sum += sampled * weight;
            wsum += weight;
        }
    }

    float result = (wsum > 0.0) ? (sum / wsum) : centerDepth;
    imageStore(gDepthModified, coords, vec4(result));
}
